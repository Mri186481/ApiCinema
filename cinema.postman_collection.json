							"  pm.expect(responseJson).to.have.property('genre');",
							"  pm.expect(responseJson).to.have.property('durationMinutes');",
							"  pm.expect(responseJson).to.have.property('filmingLatitude');",
							"  pm.expect(responseJson).to.have.property('filmingLongitude');",
							"  pm.expect(responseJson).to.have.property('releaseDate');",
							"  pm.expect(responseJson).to.have.property('currentlyShowing');",
							"  ",
							"  pm.collectionVariables.set(\"movieId\", pm.response.json().id);",
							"  pm.collectionVariables.set(\"movieTitle\", pm.response.json().movieTitle);",
							"  pm.collectionVariables.set(\"genre\", pm.response.json().genre);",
							"",
